---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import TopicTag from './TopicTag.astro';
import { readingMinutes } from '../utils/reading-time';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

// Newest first.
const posts = [...Astro.props.posts].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!-- Each post is a card: date and topic, the title as a link, the
     description, then a "Read" cue. The title link is stretched over the
     whole card, so clicking anywhere opens the post. Hero images only show
     on the post page itself. -->
<ul>
	{posts.map((post) => (
		<li>
			<p class="meta">
				<FormattedDate date={post.data.pubDate} /> · {readingMinutes(post.body)} min read
				{post.data.topic && <TopicTag topic={post.data.topic} />}
			</p>
			<h2 class="title">
				<a href={`/blog/${post.id}/`}>{post.data.title}</a>
			</h2>
			<p class="description">{post.data.description}</p>
			<p class="read" aria-hidden="true">Read <span>→</span></p>
		</li>
	))}
</ul>
<style>
	ul {
		display: grid;
		gap: 1em;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		position: relative;
		padding: 1.1em 1.25em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		transition:
			border-color 0.15s,
			transform 0.15s;
	}
	li:hover,
	li:focus-within {
		border-color: var(--accent);
	}
	li:hover {
		transform: translateY(-2px);
	}
	.meta {
		margin: 0 0 0.3em;
		color: var(--text-muted);
		font-size: 0.85em;
	}
	/* TopicTag is a separate component, so its class needs :global here.
	   It sits above the stretched title link so it stays its own link. */
	.meta :global(.topic-tag) {
		position: relative;
		z-index: 1;
		margin-left: 1em;
	}
	.title {
		margin: 0 0 0.3em;
		font-size: 1.3em;
	}
	.title a {
		color: var(--text-heading);
		text-decoration: none;
	}
	/* Stretch the link over the whole card. */
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	.title a:focus-visible {
		outline: none;
	}
	li:hover .title a,
	.title a:focus-visible {
		color: var(--accent);
	}
	.description {
		margin: 0;
		color: var(--text);
		font-family: var(--font-sans);
	}
	.read {
		margin: 0.6em 0 0;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.85em;
	}
	.read span {
		display: inline-block;
		transition: transform 0.15s;
	}
	li:hover .read span {
		transform: translateX(4px);
	}
	@media (prefers-reduced-motion: reduce) {
		li,
		.read span {
			transition: none;
		}
		li:hover {
			transform: none;
		}
	}
</style>
