---
import { getCollection } from 'astro:content';
import { TOPICS, type Topic } from '../consts';

interface Props {
	// The topic being viewed; leave out on /blog to highlight "all".
	current?: Topic;
}

const { current } = Astro.props;
const posts = await getCollection('blog');
// Each chip shows its post count; empty topics get a dashed border so they
// read as "coming soon" (still clickable: the page suggests the latest post).
const topics = (Object.keys(TOPICS) as Topic[]).map((topic) => ({
	topic,
	count: posts.filter((p) => p.data.topic === topic).length,
}));
---

<nav class="topic-nav" aria-label="Topics">
	<a href="/blog/" class:list={{ active: !current }} aria-current={!current ? 'page' : undefined}>
		all <span class="count">{posts.length}</span>
	</a>
	{topics.map(({ topic, count }) => (
		<a
			href={`/topics/${topic}/`}
			class:list={{ active: topic === current, empty: count === 0 }}
			aria-current={topic === current ? 'page' : undefined}
		>
			#{topic} <span class="count">{count}<span class="sr-only"> {count === 1 ? 'post' : 'posts'}</span></span>
		</a>
	))}
</nav>
<style>
	.topic-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 2.5em;
	}
	a {
		padding: 0.2em 0.7em;
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text-muted);
		font-size: 0.85em;
		text-decoration: none;
	}
	a:hover {
		border-color: var(--accent);
		color: var(--accent);
		text-shadow: none;
	}
	a.empty:not(.active) {
		border-style: dashed;
	}
	.count {
		margin-left: 0.15em;
		font-size: 0.85em;
		opacity: 0.8;
	}
	a.active {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--bg);
	}
</style>
