---
// AEX vs NIFTY 50 since November 2019 (the month I moved), both rebased to 100
// so two very different index levels can share one axis. Each in its own
// currency. Data: src/data/indices.json, refreshed by
// scripts/update-index-data.mjs. Hover or drag across the chart to read any
// month; without JavaScript it's a static chart.
import data from '../../data/indices.json';

const COLOURS = ['var(--accent)', '#f5a524'];
const W = 600;
const H = 260;
const PAD = { top: 16, right: 16, bottom: 34, left: 50 };

const series = data.series.map((s, i) => {
	const base = s.points[0].close;
	return {
		...s,
		colour: COLOURS[i],
		rebased: s.points.map((p) => Math.round((p.close / base) * 1000) / 10),
	};
});
const months = series[0].points.map((p) => p.month);
const n = months.length;

const all = series.flatMap((s) => s.rebased);
const lo = Math.floor(Math.min(...all) / 25) * 25;
const hi = Math.ceil(Math.max(...all) / 25) * 25;
const x = (i: number) => PAD.left + (i / (n - 1)) * (W - PAD.left - PAD.right);
const y = (v: number) => PAD.top + ((hi - v) / (hi - lo)) * (H - PAD.top - PAD.bottom);
const line = (values: number[]) => values.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join('');

const grid = Array.from({ length: (hi - lo) / 25 + 1 }, (_, k) => lo + k * 25).filter((v) => v % 50 === 0 || hi - lo <= 100);
const years = months.flatMap((m, i) => (m.endsWith('-01') ? [{ i, label: m.slice(0, 4) }] : []));
const change = (s: (typeof series)[number]) => {
	const pct = Math.round(s.rebased[s.rebased.length - 1] - 100);
	return `${pct >= 0 ? '+' : ''}${pct}%`;
};
const label = (m: string) =>
	new Date(`${m}-15`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });

// The lowest month across both. Labelled "Covid crash" only if it really is
// early 2020, so new data can't put the label in the wrong place.
const dip = series.flatMap((s) => s.rebased.map((v, i) => ({ v, i }))).sort((a, b) => a.v - b.v)[0];

const summary = series.map((s) => `${s.name} (${s.country}) ${change(s)}`).join(', ');
const chart = { months: months.map(label), series: series.map((s) => ({ name: s.name, values: s.rebased })) };
---

<figure class="index-chart" data-chart={JSON.stringify(chart)}>
	<ul class="legend">
		{
			series.map((s) => (
				<li style={`--c: ${s.colour}`}>
					<span class="swatch" aria-hidden="true" />
					{s.name} <span class="muted">({s.country}, {s.currency})</span> <b>{change(s)}</b>
				</li>
			))
		}
	</ul>
	<svg
		viewBox={`0 0 ${W} ${H}`}
		role="img"
		aria-label={`Line chart since ${label(months[0])}, rebased to 100: ${summary}.`}
	>
		{
			grid.map((v) => (
				<g class={v === 100 ? 'grid base' : 'grid'}>
					<line x1={PAD.left} x2={W - PAD.right} y1={y(v)} y2={y(v)} />
					<text x={PAD.left - 6} y={y(v) + 4} class="axis end">
						{v}
					</text>
				</g>
			))
		}
		{
			years.map(({ i, label: year }) => (
				<text x={x(i)} y={H - 6} class="axis">
					{year}
				</text>
			))
		}
		{
			/^2020-0[2-5]$/.test(months[dip.i]) && (
				<text x={x(dip.i) + 8} y={y(dip.v) + 14} class="note">
					Covid crash
				</text>
			)
		}
		{series.map((s) => <path d={line(s.rebased)} class="line" style={`--c: ${s.colour}`} />)}
		<g class="cursor" hidden>
			<line y1={PAD.top} y2={H - PAD.bottom} />
			{series.map((s) => <circle r="4" style={`--c: ${s.colour}`} />)}
		</g>
	</svg>
	<output class="readout">
		{label(months[n - 1])}: {series.map((s) => `${s.name} ${s.rebased[n - 1]}`).join(' · ')}
	</output>
	<figcaption>
		Both indexes set to 100 in {label(months[0])}, when I moved, each in its own currency. Monthly
		closes to {data.asOf}, from {data.source.split(',')[0]}.
	</figcaption>
</figure>

<script>
	for (const fig of document.querySelectorAll<HTMLElement>('.index-chart[data-chart]')) {
		const data: { months: string[]; series: { name: string; values: number[] }[] } = JSON.parse(fig.dataset.chart ?? '{}');
		const svg = fig.querySelector('svg');
		const cursor = fig.querySelector<SVGGElement>('.cursor');
		const readout = fig.querySelector('output');
		const paths = [...fig.querySelectorAll<SVGPathElement>('.line')];
		if (!svg || !cursor || !readout) continue;
		const rule = cursor.querySelector('line');
		const dots = [...cursor.querySelectorAll('circle')];
		const n = data.months.length;
		const initial = readout.textContent;

		// Points are read back from the drawn paths, so the script needs no
		// copy of the chart's scales.
		const point = (path: SVGPathElement, i: number) => {
			const [mx, my] = path
				.getAttribute('d')!
				.split(/[ML]/)
				.filter(Boolean)
				[i].split(' ')
				.map(Number);
			return { x: mx, y: my };
		};

		const show = (i: number) => {
			cursor.removeAttribute('hidden');
			const at = paths.map((p) => point(p, i));
			rule?.setAttribute('x1', String(at[0].x));
			rule?.setAttribute('x2', String(at[0].x));
			dots.forEach((dot, k) => {
				dot.setAttribute('cx', String(at[k].x));
				dot.setAttribute('cy', String(at[k].y));
			});
			readout.textContent = `${data.months[i]}: ${data.series.map((s) => `${s.name} ${s.values[i]}`).join(' · ')}`;
		};

		svg.addEventListener('pointermove', (event) => {
			const box = svg.getBoundingClientRect();
			const first = point(paths[0], 0).x;
			const last = point(paths[0], n - 1).x;
			const sx = ((event.clientX - box.left) / box.width) * svg.viewBox.baseVal.width;
			show(Math.round(((Math.min(last, Math.max(first, sx)) - first) / (last - first)) * (n - 1)));
		});
		svg.addEventListener('pointerleave', () => {
			cursor.setAttribute('hidden', '');
			readout.textContent = initial;
		});
	}
</script>

<style>
	.index-chart {
		margin: 0 0 2em;
		padding: 1em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25em 1.25em;
		margin: 0 0 0.75em;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: 0.8em;
	}
	.legend li {
		font-family: var(--font-mono);
	}
	.swatch {
		display: inline-block;
		width: 0.9em;
		height: 3px;
		margin-right: 0.4em;
		vertical-align: middle;
		background: var(--c);
	}
	.legend b {
		color: var(--c);
	}
	.muted {
		color: var(--text-muted);
	}
	svg {
		display: block;
		width: 100%;
		touch-action: pan-y;
	}
	.grid line {
		stroke: var(--border);
		stroke-width: 1;
	}
	.grid.base line {
		stroke: var(--text-muted);
		stroke-dasharray: 3 4;
	}
	.axis {
		fill: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		text-anchor: middle;
	}
	.axis.end {
		text-anchor: end;
	}
	.note {
		fill: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 10px;
	}
	.line {
		fill: none;
		stroke: var(--c);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	/* SVG ignores the hidden attribute on its own, so hide it here. */
	.cursor[hidden] {
		display: none;
	}
	.cursor line {
		stroke: var(--text-muted);
	}
	.cursor circle {
		fill: var(--c);
		stroke: var(--surface);
		stroke-width: 2;
	}
	.readout {
		display: block;
		margin-top: 0.5em;
		color: var(--text-heading);
		font-family: var(--font-mono);
		font-size: 0.8em;
		text-align: center;
	}
	/* On phones the chart is drawn at half size: scale the text and lines up
	   so they stay readable. */
	@media (max-width: 560px) {
		.axis {
			font-size: 20px;
		}
		.note {
			font-size: 18px;
		}
		.line {
			stroke-width: 3;
		}
	}
	figcaption {
		margin-top: 0.25em;
		color: var(--text-muted);
		font-size: 0.75em;
		text-align: center;
	}
</style>
