<style>
	.route {
		margin: 0 0 2em;
		padding: 1em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
	}
	svg {
		display: block;
		width: 100%;
		max-width: 30rem;
		margin: 0 auto;
		overflow: hidden; /* coastlines run past the viewBox edges */
		background: var(--bg); /* the sea */
		border: 1px solid var(--border);
		border-radius: 8px;
	}
	/* Land sits a little lighter than the sea; the coastline is a thin border. */
	.land {
		fill: color-mix(in srgb, var(--surface), var(--border) 50%);
		stroke: var(--border);
		stroke-width: 0.6;
		stroke-linejoin: round;
	}
	.arc {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-dasharray: 5 6;
		animation: travel 1.2s linear infinite;
	}
	.dot {
		fill: var(--text-heading);
	}
	.dot.home {
		fill: var(--accent);
	}
	.pulse {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.5;
		opacity: 0.5;
	}
	text {
		font-family: var(--font-mono);
		text-anchor: middle;
		/* A halo in the sea colour keeps labels readable over land. */
		paint-order: stroke;
		stroke: var(--bg);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.end {
		text-anchor: end;
	}
	.city {
		fill: var(--text-heading);
		font-size: 11px;
	}
	.km {
		fill: var(--text-muted);
		font-size: 10px;
	}
	figcaption {
		margin-top: 0.5em;
		color: var(--text-muted);
		font-size: 0.8em;
		text-align: center;
	}
	/* The dashes march from Mumbai towards Amsterdam. */
	@keyframes travel {
		to {
			stroke-dashoffset: -22;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.arc {
			animation: none;
		}
	}
</style>
