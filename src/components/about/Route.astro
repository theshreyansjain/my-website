---
// Mumbai → Amsterdam: two dots joined by a dashed arc, with the distance
// (great-circle, ~6,850 km) and the time difference.
---

<figure class="route">
	<svg viewBox="0 0 320 120" role="img" aria-label="From Mumbai to Amsterdam, about 6,850 kilometres.">
		<path d="M260 92 Q160 -10 60 40" class="arc"></path>
		<circle cx="260" cy="92" r="5" class="dot"></circle>
		<circle cx="60" cy="40" r="5" class="dot home"></circle>
		<circle cx="60" cy="40" r="11" class="pulse"></circle>
		<text x="260" y="114" class="city">Mumbai</text>
		<text x="60" y="66" class="city">Amsterdam</text>
		<text x="160" y="58" class="km">~6,850 km</text>
	</svg>
	<figcaption>From Mumbai to Amsterdam. Home is 3½ hours ahead (4½ in winter).</figcaption>
</figure>

<style>
	.route {
		margin: 0 0 2em;
		padding: 1em;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
	}
	svg {
		display: block;
		width: 100%;
		max-width: 26rem;
		margin: 0 auto;
	}
	.arc {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-dasharray: 5 6;
		animation: travel 1.2s linear infinite;
	}
	.dot {
		fill: var(--text-heading);
	}
	.dot.home {
		fill: var(--accent);
	}
	.pulse {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.5;
		opacity: 0.5;
	}
	text {
		font-family: var(--font-mono);
		text-anchor: middle;
	}
	.city {
		fill: var(--text-heading);
		font-size: 12px;
	}
	.km {
		fill: var(--text-muted);
		font-size: 11px;
	}
	figcaption {
		margin-top: 0.5em;
		color: var(--text-muted);
		font-size: 0.8em;
		text-align: center;
	}
	/* The dashes march from Mumbai towards Amsterdam. */
	@keyframes travel {
		to {
			stroke-dashoffset: -22;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.arc {
			animation: none;
		}
	}
</style>
