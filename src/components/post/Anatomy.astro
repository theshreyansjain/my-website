---
// Interactive "anatomy of this website": a drawing of the site in a browser
// window, plus the layers behind it. Hover (desktop) or tap (phone) a part
// to see what it does, what was picked and why.
// Without JavaScript every panel is shown, one after another.
import { Code } from 'astro:components';

interface Part {
	id: string;
	name: string;
	what: string;
	picked: string;
	why: string;
	alternatives: string;
	code?: { title: string; lang: 'ts' | 'css' | 'md' | 'html' | 'sh'; source: string };
}

const parts: Part[] = [
	{
		id: 'address',
		name: 'Address',
		what: 'The name you type to reach a site. It points your browser to the servers that hold it.',
		picked: 'my-website-phi-topaz.vercel.app, a free address from Vercel.',
		why: 'Free and worked straight away. A custom domain is on the list for later.',
		alternatives: 'Your own domain from a registrar such as Cloudflare or Namecheap, around €10 a year.',
	},
	{
		id: 'style',
		name: 'Look and feel',
		what: 'CSS: the rules for colours, fonts, spacing and layout.',
		picked: 'Plain CSS. Dark background, one green accent for everything you can click, and the JetBrains Mono font.',
		why: 'Nothing extra to learn or download. The font file is served from this site, so visiting doesn’t ping Google.',
		alternatives: 'Tailwind (utility classes), a ready-made theme, Google Fonts.',
		code: {
			title: 'show the colours',
			lang: 'css',
			source: `/* src/styles/global.css: colours are named by role, not shade */
:root {
	--bg: #0a0b0d;
	--text: #c9d1d9;
	--accent: #39f58c;
}`,
		},
	},
	{
		id: 'figure',
		name: 'Homepage figure',
		what: 'The animation on the homepage. Your scroll position decides the figure’s pose.',
		picked: 'A body made of CSS shapes, props drawn in SVG, moved by GSAP ScrollTrigger.',
		why: 'The whole homepage is 97 KB, and shapes stay sharp at any size. GSAP handles the scroll timing and is free.',
		alternatives: 'A 3D figure in Three.js (built, then dropped: about 600 KB and I liked the 2D one more), a video, Lottie.',
		code: {
			title: 'show the code',
			lang: 'ts',
			source: `// src/scripts/homepage.ts (simplified): one pose per scene,
// angles in degrees. Scrolling blends from one pose to the next.
const poses = {
	run:  { torso: 4,  armL: 40,  armR: -45, legL: 30, legR: -35 },
	bike: { torso: 72, armL: -32, armR: -34, bike: 1 },
};`,
		},
	},
	{
		id: 'posts',
		name: 'Posts',
		what: 'The writing itself.',
		picked: 'Markdown files in the code, one per post, checked by a schema.',
		why: 'Posts are plain text with full version history. A typo in a topic name stops the build instead of publishing a broken page.',
		alternatives: 'A CMS such as WordPress or Sanity, or a database.',
		code: {
			title: 'show a post file',
			lang: 'md',
			source: `---
title: 'Hello, world'
description: 'Why I started this site'
pubDate: '2026-10-07'
topic: 'programming-ai'
---

The post, written in Markdown.`,
		},
	},
	{
		id: 'hosting',
		name: 'Hosting: Vercel',
		what: 'Keeps the site’s files on servers around the world (a CDN) and sends them to each visitor from the nearest one.',
		picked: 'Vercel.',
		why: 'It rebuilds the site on every push. Every branch gets its own preview link, so changes can be checked before they go live. HTTPS included, free.',
		alternatives: 'Netlify, Cloudflare Pages, GitHub Pages.',
	},
	{
		id: 'build',
		name: 'Build: Astro',
		what: 'Turns posts and components into plain HTML, CSS and JavaScript files, once, before anyone visits.',
		picked: 'Astro 7, starting from its official blog template.',
		why: 'Made for content sites. It sends almost no JavaScript, and RSS, a sitemap and post pages come built in.',
		alternatives: 'Next.js, Hugo, WordPress.',
		code: { title: 'show the command', lang: 'sh', source: 'npm run build   # writes the finished site to dist/' },
	},
	{
		id: 'code',
		name: 'Code: GitHub',
		what: 'Stores the code and every version of it.',
		picked: 'GitHub, public repository.',
		why: 'Every change can be undone. Vercel watches it, and each roadmap step got its own branch.',
		alternatives: 'GitLab, Bitbucket.',
		code: { title: 'show the command', lang: 'sh', source: 'git push   # Vercel sees this and deploys' },
	},
	{
		id: 'analytics',
		name: 'Analytics',
		what: 'Counts visits: which pages, which countries, which devices.',
		picked: 'Vercel Web Analytics.',
		why: 'No cookies, so no cookie banner. One script tag.',
		alternatives: 'Plausible, Umami, Google Analytics.',
		code: {
			title: 'show the code',
			lang: 'html',
			source: '<script defer src="/_vercel/insights/script.js"></script>',
		},
	},
	{
		id: 'backend',
		name: 'Backend: none',
		what: 'A server that runs code on every visit, usually with a database.',
		picked: 'Nothing. This site has no backend.',
		why: 'A blog doesn’t need one. Nothing to run, pay for, or get hacked.',
		alternatives: 'A Node server, Supabase, Firebase.',
	},
];

const label = Object.fromEntries(parts.map((p) => [p.id, p.name]));
---

<div class="anatomy">
	<div class="diagram" role="group" aria-label="Parts of this website">
		<p class="layer-label">What you see</p>
		<div class="window">
			<div class="window-bar">
				<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
				<button type="button" class="part part-address" data-part="address">
					<span class="tag">address</span>
					<span class="url">my-website…vercel.app</span>
				</button>
			</div>
			<button type="button" class="part part-style" data-part="style">
				<span class="tag">look and feel</span>
				<span class="nav-mock" aria-hidden="true"><b>Home</b> Blog About</span>
			</button>
			<div class="window-body">
				<button type="button" class="part part-figure" data-part="figure">
					<span class="tag">figure</span>
					<svg viewBox="0 0 40 60" aria-hidden="true">
						<circle cx="20" cy="9" r="6"></circle>
						<path d="M20 15 V36 M20 20 L10 30 M20 20 L31 8 M20 36 L13 54 M20 36 L27 54"></path>
					</svg>
				</button>
				<button type="button" class="part part-posts" data-part="posts">
					<span class="tag">posts</span>
					<span class="lines" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
				</button>
			</div>
		</div>

		<p class="layer-label">Behind it</p>
		<div class="layers">
			<button type="button" class="part layer" data-part="hosting">
				<span class="tag">serves it</span>{label.hosting}
			</button>
			<span class="arrow" aria-hidden="true">▲</span>
			<button type="button" class="part layer" data-part="build">
				<span class="tag">makes it</span>{label.build}
			</button>
			<span class="arrow" aria-hidden="true">▲</span>
			<button type="button" class="part layer" data-part="code">
				<span class="tag">stores it</span>{label.code}
			</button>
			<div class="side">
				<button type="button" class="part layer" data-part="analytics">
					<span class="tag">counts visits</span>{label.analytics}
				</button>
				<button type="button" class="part layer layer-none" data-part="backend">
					<span class="tag">not needed</span>{label.backend}
				</button>
			</div>
		</div>
	</div>

	<div class="panels" aria-live="polite">
		{
			parts.map((p) => (
				<section class="panel" data-panel={p.id}>
					<h3>{p.name}</h3>
					<p class="what">{p.what}</p>
					<dl>
						<dt>Picked</dt>
						<dd>{p.picked}</dd>
						<dt>Why</dt>
						<dd>{p.why}</dd>
						<dt>Alternatives</dt>
						<dd>{p.alternatives}</dd>
					</dl>
					{p.code && (
						<details class="expand expand-code">
							<summary>{p.code.title}</summary>
							<Code code={p.code.source} lang={p.code.lang} theme="github-dark" />
						</details>
					)}
				</section>
			))
		}
	</div>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('.anatomy')) {
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-part]')];
		const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
		const panelBox = root.querySelector<HTMLElement>('.panels');
		const canHover = matchMedia('(hover: hover)').matches;
		const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

		const select = (id: string, reveal = false) => {
			for (const b of buttons) {
				const on = b.dataset.part === id;
				b.classList.toggle('is-active', on);
				b.setAttribute('aria-pressed', String(on));
			}
			for (const p of panels) p.hidden = p.dataset.panel !== id;
			// Phones show the panel under the diagram: bring it into view.
			if (reveal && panelBox && !canHover) {
				const box = panelBox.getBoundingClientRect();
				if (box.top > innerHeight - 120) {
					panelBox.scrollIntoView({ block: 'nearest', behavior: calm ? 'auto' : 'smooth' });
				}
			}
		};

		root.classList.add('is-interactive');
		for (const b of buttons) {
			const id = b.dataset.part ?? '';
			b.addEventListener('click', () => select(id, true));
			b.addEventListener('focus', () => select(id));
			if (canHover) b.addEventListener('mouseenter', () => select(id));
		}
		select(buttons[0]?.dataset.part ?? '');
	}
</script>

<style>
	/* Wider than the 720px text column on big screens. */
	.anatomy {
		margin: 0 calc(50% - min(32rem, 50vw - 1rem)) 2em;
		font-size: 0.9em;
	}
	@media (min-width: 900px) {
		.anatomy {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 2rem;
			align-items: start;
		}
		.panels {
			position: sticky;
			top: 1.5rem;
		}
	}

	.layer-label {
		margin: 0 0 0.5em;
		color: var(--text-muted);
		font-size: 0.8em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.layer-label + .window,
	.layer-label + .layers {
		margin-bottom: 1.5em;
	}

	/* Every clickable part. Selected parts grow outwards: padding goes up and
	   margin goes down by the same amount, so nothing around them moves. */
	.part {
		--pad: 0.6rem;
		--grow: 0.35rem;
		position: relative;
		display: block;
		width: 100%;
		margin: 0;
		padding: var(--pad);
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg);
		color: var(--text);
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition:
			padding 0.2s,
			margin 0.2s,
			opacity 0.2s,
			border-color 0.2s,
			box-shadow 0.2s;
	}
	.part:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.is-interactive .part:not(.is-active) {
		opacity: 0.55;
	}
	.is-interactive .part:hover {
		opacity: 1;
	}
	.part.is-active {
		z-index: 1;
		margin: calc(var(--grow) * -1);
		padding: calc(var(--pad) + var(--grow));
		width: calc(100% + var(--grow) * 2);
		border-color: var(--accent);
		background: var(--surface);
		box-shadow: 0 0 16px var(--accent-glow);
	}
	.tag {
		display: block;
		margin-bottom: 0.25em;
		color: var(--accent);
		font-size: 0.75em;
	}

	/* The browser window. */
	.window {
		display: grid;
		gap: 0.5rem;
		padding: 0.5rem;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
	}
	.window-bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.dots {
		display: flex;
		gap: 4px;
		flex: none;
	}
	.dots i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--border);
	}
	.part-address {
		--pad: 0.3rem 0.6rem;
		--grow: 0.3rem;
	}
	.part-address.is-active {
		padding: calc(0.3rem + var(--grow)) calc(0.6rem + var(--grow));
	}
	.url {
		color: var(--text-muted);
	}
	.nav-mock {
		color: var(--text-muted);
		word-spacing: 0.6em;
	}
	.nav-mock b {
		color: var(--text-heading);
		font-weight: 400;
	}
	.window-body {
		display: grid;
		grid-template-columns: 2fr 3fr;
		gap: 0.5rem;
	}
	.part-figure svg {
		display: block;
		width: 100%;
		max-height: 7rem;
		fill: none;
		stroke: var(--text-heading);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.lines {
		display: grid;
		gap: 0.6rem;
		padding-top: 0.3rem;
	}
	.lines i {
		height: 0.5rem;
		border-radius: 3px;
		background: var(--border);
	}
	.lines i:nth-child(odd) {
		width: 70%;
		background: var(--text-muted);
	}

	/* The layers behind the page. */
	.layers {
		display: grid;
		justify-items: center;
		gap: 0.3rem;
	}
	.arrow {
		color: var(--text-muted);
		font-size: 0.7em;
		line-height: 1;
	}
	.side {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		width: 100%;
		margin-top: 0.75rem;
	}
	.layer-none {
		border-style: dashed;
	}

	/* The explanation panel. */
	.panels {
		margin-top: 1.5em;
		padding: 1em 1.25em;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
	}
	@media (min-width: 900px) {
		.panels {
			margin-top: 0;
		}
	}
	/* Only needed without JavaScript, when every panel is shown. */
	.anatomy:not(.is-interactive) .panel + .panel {
		margin-top: 2em;
	}
	.panel h3 {
		font-size: 1.2em;
	}
	.panel .what {
		margin: 0 0 1em;
	}
	dl {
		margin: 0;
	}
	dt {
		color: var(--accent);
		font-size: 0.8em;
	}
	dd {
		margin: 0 0 0.75em;
	}
	.panel details summary {
		color: var(--text-muted);
		font-size: 0.85em;
		cursor: pointer;
	}
	.panel details :global(pre) {
		margin: 0.5em 0 0;
		padding: 1em;
		font-size: 0.85em;
	}

	@media (prefers-reduced-motion: reduce) {
		.part {
			transition: none;
		}
		.part.is-active {
			margin: 0;
			padding: var(--pad);
			width: 100%;
		}
		.part-address.is-active {
			padding: var(--pad);
		}
	}
</style>
