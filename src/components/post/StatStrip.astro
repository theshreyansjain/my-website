---
// A row of big numbers with small labels.
interface Props {
	stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
---

<dl class="stats">
	{
		stats.map((s) => (
			<div>
				<dt>{s.label}</dt>
				<dd>{s.value}</dd>
			</div>
		))
	}
</dl>

<style>
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
		gap: 0.75rem;
		margin: 0 0 2em;
	}
	.stats div {
		display: flex;
		flex-direction: column-reverse;
		padding: 0.75em 1em;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
	}
	dd {
		margin: 0;
		color: var(--accent);
		font-size: 1.5em;
		font-weight: 700;
		line-height: 1.2;
	}
	dt {
		color: var(--text-muted);
		font-size: 0.8em;
	}
</style>
