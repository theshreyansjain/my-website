---
// The design chat and Claude Code can't talk to each other; a shared
// file in the repo is the only channel.
---

<figure class="two-claudes">
	<div class="box">
		<span class="tag">claude.ai chat</span>
		<strong>Design</strong>
		<span class="note">ideas, decisions, questions</span>
	</div>
	<div class="link" aria-hidden="true">⇄</div>
	<div class="box file">
		<span class="tag">in the repo</span>
		<strong>docs/plan.md</strong>
		<span class="note">roadmap, decisions, build notes</span>
	</div>
	<div class="link" aria-hidden="true">⇄</div>
	<div class="box">
		<span class="tag">Claude Code</span>
		<strong>Building</strong>
		<span class="note">code, previews, commits</span>
	</div>
	<figcaption>Two Claudes and a text file. Neither can see the other, only the file.</figcaption>
</figure>

<style>
	.two-claudes {
		display: grid;
		grid-template-columns: 1fr auto 1fr auto 1fr;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 2em;
		font-size: 0.85em;
	}
	.box {
		display: flex;
		flex-direction: column;
		padding: 0.75em;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
		text-align: center;
	}
	.file {
		border-color: var(--accent);
		box-shadow: 0 0 12px var(--accent-glow);
	}
	.tag {
		color: var(--accent);
		font-size: 0.85em;
	}
	strong {
		color: var(--text-heading);
		overflow-wrap: anywhere;
	}
	.note {
		color: var(--text-muted);
		font-size: 0.85em;
		line-height: 1.4;
	}
	.link {
		color: var(--accent);
		font-size: 1.3em;
		text-align: center;
	}
	figcaption {
		grid-column: 1 / -1;
		margin-top: 0.25em;
		color: var(--text-muted);
		font-size: 0.9em;
		text-align: center;
	}
	/* Stacked on phones, arrows turned to point up and down. */
	@media (max-width: 560px) {
		.two-claudes {
			grid-template-columns: 1fr;
		}
		.link {
			transform: rotate(90deg);
		}
	}
</style>
