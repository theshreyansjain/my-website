---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NextUp from '../components/NextUp.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import CopyButtons from '../components/CopyButtons.astro';
import TopicTag from '../components/TopicTag.astro';
import { SITE_TITLE } from '../consts';

// Post frontmatter; the date is optional so non-post pages (About) can use
// this layout without one. Posts also pass their id and reading time.
type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate'> & { pubDate?: Date; id?: string; minutes?: number };

const { title, description, pubDate, updatedDate, heroImage, ogImage, topic, id, minutes } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			image={ogImage ?? heroImage}
			article={pubDate && { publishedTime: pubDate }}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--text);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--text-muted);
			}
			.next {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 3em auto 0;
				padding: 0 1em;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		{pubDate && <ReadingProgress />}
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							{pubDate && <FormattedDate date={pubDate} />}
							{minutes && <span> · {minutes} min read</span>}
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						{topic && <TopicTag topic={topic} />}
						<h1>{title}</h1>
						<hr />
					</div>
					<div data-progress-target>
						<slot />
					</div>
				</div>
			</article>
			{pubDate && (
				<div class="next">
					<NextUp heading="Keep reading" exclude={id} />
				</div>
			)}
		</main>
		<Footer />
		<CopyButtons />
	</body>
</html>
