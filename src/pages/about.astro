---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import portrait from '../assets/about/portrait.jpg';
import IndexChart from '../components/about/IndexChart.astro';
import Route from '../components/about/Route.astro';
import TopicCards from '../components/about/TopicCards.astro';
import Whoami from '../components/about/Whoami.astro';
import PostList from '../components/PostList.astro';
import Layout from '../layouts/BlogPost.astro';

const [latest] = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="About" description="Quant trader from Mumbai, living in Amsterdam. What I do and what this site is for.">
	<div class="intro">
		<Image
			src={portrait}
			alt="Shreyans in sports sunglasses, grinning next to a tabby cat that has pushed its face right up to the camera."
			width={160}
			height={160}
			densities={[1, 2]}
			class="portrait"
			loading="eager"
		/>
		<p class="lead">
			I'm Shreyans, a quant trader from Mumbai, living in Amsterdam. I work at an options market
			maker. Outside work, I love learning new things, building things, and spending time outdoors
			doing sports.
		</p>
	</div>

	<Whoami
		rows={[
			['name', 'Shreyans'],
			['role', 'Quant trader at an options market maker'],
			['from', 'Mumbai'],
			['based', 'Amsterdam'],
			['likes', 'Learning, building, outdoor sports'],
			['status', 'Documenting my side quests'],
		]}
	/>

	<h2>From Mumbai to Amsterdam</h2>
	<Route />

	<h2>Markets since I moved</h2>
	<p>
		I trade for a living, so here's a market chart: how the main stock indexes of the Netherlands and
		India have done since I arrived. Hover or drag across it to read any month.
	</p>
	<IndexChart />

	<h2>Why this site</h2>
	<p>
		Mostly to learn AI by building something with it. Making something real and watching it work
		gives me the same eureka feeling as the first HTML file I ever wrote. It's also a home for my
		side quests: writing things down gives what I learn some structure, and it gives friends and
		family an easy way to keep up with what I'm doing.
	</p>
	<p>
		I didn't write the code myself. Claude Code did, while I decided what the site should be and
		how it should look. <a
			href="/blog/building-this-site/">Here's how it was built.</a
		>
	</p>

	<h2>What I write about</h2>
	<TopicCards />

	{
		latest && (
			<>
				<h2>Latest post</h2>
				<PostList posts={[latest]} />
			</>
		)
	}
</Layout>

<style>
	/* The page title, from the shared layout: green on this page only. */
	:global(.title h1) {
		color: var(--accent);
	}
	.intro {
		display: flex;
		align-items: center;
		gap: 1.5em;
		margin-bottom: 2em;
	}
	.intro .lead {
		margin: 0;
	}
	/* Rounded-square photo with a thin green ring (a circle would cut off
	   the edge of my face; the cat takes up the rest). */
	.intro :global(.portrait) {
		flex: none;
		width: 160px;
		height: 160px;
		border-radius: 22%;
		object-fit: cover;
		border: 2px solid var(--accent);
		box-shadow: 0 0 20px var(--accent-glow);
	}
	/* Phones: photo above the text, centred. */
	@media (max-width: 560px) {
		.intro {
			flex-direction: column;
			text-align: center;
		}
		.intro :global(.portrait) {
			width: 128px;
			height: 128px;
		}
	}
	.lead {
		font-size: 1.15em;
	}
	h2 {
		margin-top: 1.5em;
		font-size: 1.3em;
	}
	:global(.whoami) {
		margin-bottom: 2em;
	}
</style>
