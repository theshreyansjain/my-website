---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOPICS, type Topic } from '../consts';

// The homepage scenes, in scroll order (see "Homepage plan" in docs/plan.md).
// `id` must match a pose in src/scripts/homepage.ts.
const scenes: { id: string; title: string; text: string; topics: Topic[] }[] = [
	{
		id: 'stand',
		title: "Hi, I'm Shreyans.",
		text: 'This is where I write down what I learn. Scroll to look around.',
		topics: [],
	},
	{
		id: 'run',
		title: 'Running',
		text: 'Training logs, races and what I learn about building endurance.',
		topics: ['running'],
	},
	{
		id: 'bike',
		title: 'Biking',
		text: 'Rides, routes and gear.',
		topics: ['biking'],
	},
	{
		id: 'desk',
		title: 'Productivity',
		text: 'Code and AI, quant trading, and personal finance.',
		topics: ['programming-ai', 'quant', 'finance'],
	},
	{
		id: 'read',
		title: 'Psychology',
		text: 'Notes on how minds work, mostly from books.',
		topics: ['psychology'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- Placeholder figure; replaced by the Three.js figure in step 5. -->
			<div class="stage" aria-hidden="true">
				<div class="figure-scale">
				<div class="figure">
					<div class="prop prop-bike"><span></span><span></span></div>
					<div class="prop prop-desk">
						<span class="monitor"></span>
						<span class="monitor-stand"></span>
						<span class="desk-top"></span>
						<span class="desk-leg"></span>
					</div>
					<div class="prop prop-book"><span class="page page-l"></span><span class="page page-r"></span></div>
					<div class="part head">
						<span class="gear headband"></span>
						<!-- Brain parts that burst out of the head in the psychology scene. -->
						<span class="brain frontal"></span>
						<span class="brain parietal"></span>
						<span class="brain occipital"></span>
						<span class="brain temporal"></span>
						<span class="brain cerebellum"></span>
						<span class="brain stem"></span>
					</div>
					<div class="part torso"></div>
					<div class="part arm arm-l"><span class="seg"></span></div>
					<div class="part arm arm-r"><span class="seg"></span></div>
					<div class="part leg leg-l"><span class="seg"><span class="gear shoe"></span></span></div>
					<div class="part leg leg-r"><span class="seg"><span class="gear shoe"></span></span></div>
				</div>
				</div>
			</div>

			{scenes.map((scene, i) => (
				<section class="scene" data-scene={scene.id} style={`grid-row: ${i + 1}`}>
					<div class="scene-text">
						{i === 0 ? <h1>{scene.title}</h1> : <h2>{scene.title}</h2>}
						<p>{scene.text}</p>
						{scene.topics.length > 0 ? (
							<p class="links">
								{scene.topics.map((topic) => (
									<a class="button" href={`/topics/${topic}/`}>
										{TOPICS[topic]}
									</a>
								))}
							</p>
						) : (
							<p class="links">
								<a class="button" href="/blog/">All posts</a>
							</p>
						)}
					</div>
				</section>
			))}
		</main>
		<Footer />
		<script>
			import '../scripts/homepage.ts';
		</script>
	</body>
</html>

<style>
	/* Full-width page: undo the narrow column that global.css gives <main>. */
	main.home {
		display: grid;
		grid-template-columns: 1fr;
		width: auto;
		max-width: none;
		padding: 0;
	}

	/* The stage spans every scene's row and sticks to the top of the screen,
	   so the figure stays put while the scene text scrolls past it. */
	.stage {
		grid-column: 1;
		grid-row: 1 / span 5;
		position: sticky;
		top: 0;
		align-self: start;
		height: 100svh;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 12svh;
		box-sizing: border-box;
		pointer-events: none;
	}

	.scene {
		grid-column: 1;
		position: relative;
		z-index: 1;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		padding: 0 1em 3em;
		box-sizing: border-box;
	}
	.scene-text {
		width: 100%;
		max-width: 32em;
		/* Fades out the figure behind the text on small screens. */
		background: linear-gradient(to bottom, transparent, var(--bg) 2em);
		padding-top: 2em;
	}
	.scene h1,
	.scene h2 {
		font-size: 2em;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.button {
		padding: 0.4em 0.9em;
		border: 1px solid var(--accent);
		border-radius: 4px;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent);
		color: var(--bg);
		text-shadow: none;
	}

	/* Scales the whole figure. A wrapper is used because GSAP owns the
	   transform on .figure itself.
	   Defined before the media queries below so their sizes win. */
	.figure-scale {
		--figure-scale: 1.6;
		transform: scale(var(--figure-scale));
		transform-origin: top center;
	}

	/* Tablet and desktop: figure on the left, text on the right. */
	@media (min-width: 700px) {
		main.home {
			grid-template-columns: 1fr 1fr;
		}
		.stage {
			grid-column: 1;
			align-items: center;
			padding-top: 0;
		}
		.scene {
			grid-column: 2;
			align-items: center;
			padding: 0 8vw 0 2em;
		}
		.figure-scale {
			--figure-scale: 2.3;
			transform-origin: center;
		}
		.scene-text {
			background: none;
		}
	}

	/* Short screens: keep the figure inside the screen and clear of the text. */
	@media (max-width: 699px) and (max-height: 700px) {
		.figure-scale {
			--figure-scale: 1.25;
		}
	}
	@media (min-width: 700px) and (max-height: 700px) {
		.figure-scale {
			--figure-scale: 1.7;
		}
	}
	/* Tall desktop screens: go bigger still. */
	@media (min-width: 700px) and (min-height: 950px) {
		.figure-scale {
			--figure-scale: 2.7;
		}
	}

	/* --- Placeholder figure: simple blocks GSAP can rotate per pose. --- */
	.figure {
		position: relative;
		width: 200px;
		height: 260px;
		--limb: var(--text-heading);
	}
	.part,
	.prop {
		position: absolute;
	}
	.part {
		background: var(--limb);
		border-radius: 999px;
	}
	.head {
		width: 36px;
		height: 36px;
		left: 82px;
		top: 20px;
	}
	.torso {
		width: 26px;
		height: 80px;
		left: 87px;
		top: 62px;
		transform-origin: 50% 100%;
	}
	/* Limbs: the outer element takes the scroll pose, the inner .seg is what
	   you see, and the motion loops (wave, stride, pedalling) rotate it on
	   top of the pose without fighting the scroll timeline. */
	.arm,
	.leg {
		background: none;
	}
	.seg {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		transform-origin: inherit;
		background: var(--text-muted);
	}
	.arm-r .seg,
	.leg-r .seg {
		background: var(--limb);
	}
	.arm {
		width: 12px;
		height: 64px;
		left: 94px;
		top: 68px;
		transform-origin: 50% 6px;
	}
	.leg {
		width: 14px;
		height: 86px;
		left: 93px;
		top: 136px;
		transform-origin: 50% 7px;
	}
	/* Running gear sits inside the head and legs so it moves with them. */
	.gear {
		position: absolute;
		opacity: 0;
		background: var(--accent);
	}
	.headband {
		left: -2px;
		top: 9px;
		width: 40px;
		height: 7px;
		border-radius: 2px;
	}
	/* The knot's tail, at the back of the head (the figure faces right). */
	.headband::after {
		content: '';
		position: absolute;
		left: -9px;
		top: 2px;
		width: 12px;
		height: 4px;
		background: inherit;
		transform: rotate(25deg);
		transform-origin: right center;
	}
	.shoe {
		left: -1px;
		bottom: -3px;
		width: 26px;
		height: 10px;
		border-radius: 3px 8px 4px 4px;
	}
	/* Brain structures: hidden inside the head until the psychology scene's
	   loop explodes them outward (positions in src/scripts/homepage.ts). */
	.brain {
		position: absolute;
		left: 50%;
		top: 50%;
		opacity: 0;
		box-sizing: border-box;
		border: 2px solid var(--accent);
		background: var(--bg);
	}
	.frontal {
		width: 18px;
		height: 14px;
		margin: -7px 0 0 -9px;
		border-radius: 60% 80% 40% 50%;
	}
	.parietal {
		width: 18px;
		height: 12px;
		margin: -6px 0 0 -9px;
		border-radius: 80% 80% 30% 30%;
	}
	.occipital {
		width: 13px;
		height: 13px;
		margin: -6px 0 0 -6px;
		border-radius: 80% 30% 50% 70%;
	}
	.temporal {
		width: 20px;
		height: 9px;
		margin: -4px 0 0 -10px;
		border-radius: 50% 70% 60% 40%;
	}
	.cerebellum {
		width: 13px;
		height: 10px;
		margin: -5px 0 0 -6px;
		border-radius: 50%;
		/* Folds. */
		background:
			repeating-linear-gradient(to bottom, transparent 0 2px, var(--accent) 2px 3px),
			var(--bg);
	}
	.stem {
		width: 6px;
		height: 14px;
		margin: -7px 0 0 -3px;
		border-radius: 3px 3px 2px 2px;
	}
	.prop {
		opacity: 0;
		border: 2px solid var(--accent);
	}
	.prop-bike {
		inset: auto 10px 0 10px;
		height: 60px;
		border: none;
	}
	.prop-bike span {
		position: absolute;
		bottom: 0;
		width: 56px;
		height: 56px;
		border: 2px solid var(--accent);
		border-radius: 50%;
	}
	.prop-bike span:last-child {
		right: 0;
	}
	/* Spokes, so you can see the wheels turn. */
	.prop-bike span::before,
	.prop-bike span::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 4px;
		bottom: 4px;
		width: 2px;
		margin-left: -1px;
		background: var(--accent);
	}
	.prop-bike span::after {
		transform: rotate(90deg);
	}
	/* Desk with a computer monitor; the hands rest on the desk top. */
	.prop-desk {
		inset: 0;
		border: none;
	}
	.prop-desk span {
		position: absolute;
		background: var(--accent);
	}
	.prop-desk .monitor {
		left: 146px;
		top: 46px;
		width: 50px;
		height: 36px;
		box-sizing: border-box;
		border: 2px solid var(--accent);
		border-radius: 3px;
		/* Three short "code lines" on the screen. */
		background:
			linear-gradient(var(--accent), var(--accent)) 6px 8px / 24px 2px no-repeat,
			linear-gradient(var(--accent), var(--accent)) 10px 15px / 28px 2px no-repeat,
			linear-gradient(var(--accent), var(--accent)) 10px 22px / 16px 2px no-repeat,
			var(--bg);
	}
	.prop-desk .monitor-stand {
		left: 168px;
		top: 82px;
		width: 6px;
		height: 14px;
	}
	.prop-desk .desk-top {
		left: 120px;
		top: 96px;
		width: 84px;
		height: 3px;
	}
	.prop-desk .desk-leg {
		left: 198px;
		top: 96px;
		width: 3px;
		height: 92px;
	}
	/* An open book held in both hands, pages tilted like an open spine. */
	.prop-book {
		left: 138px;
		top: 56px;
		width: 52px;
		height: 34px;
		border: none;
	}
	.page {
		position: absolute;
		top: 0;
		width: 26px;
		height: 32px;
		box-sizing: border-box;
		border: 2px solid var(--accent);
		/* Lines of text. */
		background:
			repeating-linear-gradient(to bottom, transparent 0 6px, var(--accent) 6px 7px) 4px 5px / 14px 20px
				no-repeat,
			var(--bg);
	}
	.page-l {
		left: 0;
		border-radius: 3px 0 0 3px;
		transform: skewY(8deg);
		transform-origin: right center;
	}
	.page-r {
		right: 0;
		border-radius: 0 3px 3px 0;
		transform: skewY(-8deg);
		transform-origin: left center;
	}
</style>
