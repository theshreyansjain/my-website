---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOPICS, type Topic } from '../consts';

// The homepage scenes, in scroll order (see "Homepage plan" in docs/plan.md).
// `id` must match a pose in src/scripts/homepage.ts.
// Topic scenes show only their buttons under the sticky "I write about"
// heading; `title` labels the section for screen readers.
// The intro's text is written out in the markup below, since parts of it are
// highlighted.
const scenes: { id: string; title: string; text?: string; topics: Topic[] }[] = [
	{ id: 'stand', title: 'Intro', topics: [] },
	{
		id: 'run',
		title: 'Running',
		text: 'Training logs, races and what I learn about building endurance.',
		topics: ['running'],
	},
	{ id: 'bike', title: 'Biking', text: 'Rides, routes and gear.', topics: ['biking'] },
	{
		id: 'desk',
		title: 'Productivity',
		text: 'Code and AI, quant trading, and personal finance.',
		topics: ['programming-ai', 'quant', 'finance'],
	},
	{
		id: 'read',
		title: 'Psychology',
		text: 'Notes on how minds work, mostly from books.',
		topics: ['psychology'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- Placeholder figure; replaced by the Three.js figure in step 5. -->
			<div class="stage" aria-hidden="true">
				<div class="figure-scale">
				<div class="figure">
					<div class="prop prop-bike">
						<!-- Frame in the figure's own coordinates (200 x 260): rear hub
						     38,232, chainring 100,220, saddle under the hip, front hub
						     162,232, handlebar where the hands land. -->
						<svg class="bike-frame" viewBox="0 0 200 260">
							<path d="M38 232 L100 220 L98 152 Z" />
							<path d="M98 156 L172 146 L100 220" />
							<path d="M174 138 L162 232" />
							<path d="M166 136 L184 134 L188 143" />
							<path class="saddle" d="M86 148 L110 148" />
							<circle cx="100" cy="220" r="9" />
						</svg>
						<span class="wheel"></span>
						<span class="wheel"></span>
					</div>
					<div class="prop prop-desk">
						<span class="monitor"></span>
						<span class="monitor-stand"></span>
						<span class="desk-top"></span>
						<span class="desk-leg"></span>
						<span class="stool-seat"></span>
						<span class="stool-leg"></span>
						<span class="stool-base"></span>
					</div>
					<div class="prop prop-book"><span class="page page-l"></span><span class="page page-r"></span></div>
					<!-- Superhero cape, behind the body; shown on the intro only. -->
					<div class="cape"></div>
					<div class="part head">
						<span class="gear headband"></span>
						<span class="bike-gear helmet"></span>
						<!-- Brain parts that burst out of the head in the psychology scene. -->
						<span class="brain frontal"></span>
						<span class="brain parietal"></span>
						<span class="brain occipital"></span>
						<span class="brain temporal"></span>
						<span class="brain cerebellum"></span>
						<span class="brain stem"></span>
					</div>
					<div class="part torso"></div>
					<div class="part arm arm-l"><span class="seg"></span></div>
					<div class="part arm arm-r"><span class="seg"></span></div>
					<div class="part leg leg-l"><span class="seg"><span class="gear shoe"></span></span></div>
					<div class="part leg leg-r"><span class="seg"><span class="gear shoe"></span></span></div>
				</div>
				</div>
			</div>

			<!-- Pinned in one place for the whole homepage. Scrolling fades it in
			     after the intro and cross-fades between each scene's buttons
			     (src/scripts/homepage.ts), instead of them scrolling past. -->
			<div class="topic-panel" style="grid-row: 1 / span 5">
				<h2 class="write-about">
					I write about<span class="dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span>
				</h2>
				<div class="topic-groups">
					{scenes.slice(1).map((scene) => (
						<div class="topic-group" data-scene={scene.id} aria-label={scene.title}>
							<p class="links">
								{scene.topics.map((topic) => (
									<a class="button" href={`/topics/${topic}/`}>
										{TOPICS[topic]}
									</a>
								))}
							</p>
							<p class="topic-text">{scene.text}</p>
						</div>
					))}
				</div>
			</div>

			<!-- One full-screen section per scene. Only the intro has visible
			     content; the rest are scroll distance for the figure and fades. -->
			{scenes.map((scene, i) =>
				i === 0 ? (
					<section class="scene" data-scene={scene.id} style="grid-row: 1">
						<div class="scene-text">
							<h1>Hi, I'm <span class="highlight">Shreyans</span>.</h1>
							<p>
								This is where I write down what I learn.
								<br />
								<span class="highlight">Scroll</span> to look around.
							</p>
						</div>
					</section>
				) : (
					<div class="scene" data-scene={scene.id} style={`grid-row: ${i + 1}`}></div>
				),
			)}
		</main>
		<Footer />
		<script>
			import '../scripts/homepage.ts';
		</script>
	</body>
</html>

<style>
	/* Full-width page: undo the narrow column that global.css gives <main>. */
	main.home {
		/* Where the sticky "I write about" heading sits; topic buttons line up
		   under it. Below the figure on phones, beside it on desktop. */
		--label-top: 64svh;
		display: grid;
		grid-template-columns: 1fr;
		width: auto;
		max-width: none;
		padding: 0;
	}

	/* The stage spans every scene's row and sticks to the top of the screen,
	   so the figure stays put while the scene text scrolls past it. */
	.stage {
		grid-column: 1;
		grid-row: 1 / span 5;
		position: sticky;
		top: 0;
		align-self: start;
		height: 100svh;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 12svh;
		box-sizing: border-box;
		pointer-events: none;
	}

	.scene {
		grid-column: 1;
		position: relative;
		z-index: 1;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		padding: 0 1em 3em;
		box-sizing: border-box;
	}
	.scene-text {
		width: 100%;
		max-width: 32em;
		/* Fades out the figure behind the text on small screens. */
		background: linear-gradient(to bottom, transparent, var(--bg) 2em);
		padding-top: 2em;
	}
	.scene h1 {
		font-size: 2em;
	}
	.highlight {
		color: var(--accent);
	}
	.topic-panel {
		grid-column: 1;
		position: sticky;
		top: var(--label-top);
		align-self: start;
		z-index: 2;
		padding: 0 1em;
	}
	.write-about {
		margin: 0 0 0.8em;
		color: var(--text-heading);
		font-size: 1.6em;
	}
	/* All groups share one grid cell, so they sit on top of each other and
	   only the visible one shows. */
	.topic-groups {
		display: grid;
	}
	.topic-group {
		grid-area: 1 / 1;
		align-self: start;
	}
	.topic-group .links {
		margin: 0;
	}
	.topic-text {
		margin: 0.8em 0 0;
		max-width: 32em;
	}
	/* "I write about..." with the dots appearing one, two, three, then
	   starting over. */
	.dots span {
		animation: dot 1.6s steps(1, end) infinite;
	}
	.dots span:nth-child(2) {
		animation-name: dot2;
	}
	.dots span:nth-child(3) {
		animation-name: dot3;
	}
	@keyframes dot {
		0% { opacity: 0; }
		25% { opacity: 1; }
	}
	@keyframes dot2 {
		0% { opacity: 0; }
		50% { opacity: 1; }
	}
	@keyframes dot3 {
		0% { opacity: 0; }
		75% { opacity: 1; }
	}
	@media (prefers-reduced-motion: reduce) {
		.dots span {
			animation: none;
		}
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.button {
		padding: 0.4em 0.9em;
		border: 1px solid var(--accent);
		border-radius: 4px;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent);
		color: var(--bg);
		text-shadow: none;
	}

	/* Scales the whole figure. A wrapper is used because GSAP owns the
	   transform on .figure itself.
	   Defined before the media queries below so their sizes win. */
	.figure-scale {
		--figure-scale: 1.6;
		transform: scale(var(--figure-scale));
		transform-origin: top center;
	}

	/* Tablet and desktop: figure on the left, text on the right. */
	@media (min-width: 700px) {
		main.home {
			grid-template-columns: 1fr 1fr;
			--label-top: 40svh;
		}
		.topic-panel {
			grid-column: 2;
			padding: 0 8vw 0 2em;
		}
		.stage {
			grid-column: 1;
			align-items: center;
			padding-top: 0;
		}
		.scene {
			grid-column: 2;
			align-items: center;
			padding: 0 8vw 0 2em;
		}
		.figure-scale {
			--figure-scale: 2.3;
			transform-origin: center;
		}
		.scene-text {
			background: none;
		}

	}

	/* Short screens: keep the figure inside the screen and clear of the text. */
	@media (max-width: 699px) and (max-height: 700px) {
		.figure-scale {
			--figure-scale: 1.25;
		}
	}
	@media (min-width: 700px) and (max-height: 700px) {
		.figure-scale {
			--figure-scale: 1.7;
		}
	}
	/* Tall desktop screens: go bigger still. */
	@media (min-width: 700px) and (min-height: 950px) {
		.figure-scale {
			--figure-scale: 2.7;
		}
	}

	/* --- Placeholder figure: simple blocks GSAP can rotate per pose. --- */
	.figure {
		position: relative;
		width: 200px;
		height: 260px;
		--limb: var(--text-heading);
	}
	.part,
	.prop {
		position: absolute;
	}
	.part {
		background: var(--limb);
		border-radius: 999px;
	}
	.head {
		width: 36px;
		height: 36px;
		left: 82px;
		top: 20px;
	}
	.torso {
		width: 26px;
		height: 80px;
		left: 87px;
		top: 62px;
		transform-origin: 50% 100%;
	}
	/* Limbs: the outer element takes the scroll pose, the inner .seg is what
	   you see, and the motion loops (wave, stride, pedalling) rotate it on
	   top of the pose without fighting the scroll timeline. */
	.arm,
	.leg {
		background: none;
	}
	.seg {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		transform-origin: inherit;
		background: var(--text-muted);
	}
	.arm-r .seg,
	.leg-r .seg {
		background: var(--limb);
	}
	.arm {
		width: 12px;
		height: 64px;
		left: 94px;
		top: 68px;
		transform-origin: 50% 6px;
	}
	.leg {
		width: 14px;
		height: 86px;
		left: 93px;
		top: 136px;
		transform-origin: 50% 7px;
	}
	/* Running gear sits inside the head and legs so it moves with them. */
	.gear {
		position: absolute;
		opacity: 0;
		background: var(--accent);
	}
	.headband {
		left: -2px;
		top: 9px;
		width: 40px;
		height: 7px;
		border-radius: 2px;
	}
	/* The knot's tail, at the back of the head (the figure faces right). */
	.headband::after {
		content: '';
		position: absolute;
		left: -9px;
		top: 2px;
		width: 12px;
		height: 4px;
		background: inherit;
		transform: rotate(25deg);
		transform-origin: right center;
	}
	/* Cape: hangs from the shoulders and flares out toward the bottom, with
	   a slightly uneven hem. Billows with the wave (homepage.ts). */
	.cape {
		position: absolute;
		left: 62px;
		top: 64px;
		width: 76px;
		height: 124px;
		opacity: 0;
		background: var(--accent);
		clip-path: polygon(30% 0, 70% 0, 100% 96%, 82% 100%, 64% 95%, 46% 100%, 28% 95%, 12% 100%, 0 96%);
		transform-origin: 50% 0;
	}
	/* Bike helmet: a dome over the top of the head with a short visor at
	   the front (the figure faces right). */
	.bike-gear {
		position: absolute;
		opacity: 0;
		background: var(--accent);
	}
	.helmet {
		left: -3px;
		top: -5px;
		width: 42px;
		height: 22px;
		border-radius: 50% 50% 12% 12% / 90% 90% 20% 20%;
	}
	.helmet::after {
		content: '';
		position: absolute;
		right: -7px;
		bottom: 2px;
		width: 10px;
		height: 4px;
		border-radius: 2px;
		background: inherit;
	}
	.shoe {
		left: -1px;
		bottom: -3px;
		width: 26px;
		height: 10px;
		border-radius: 3px 8px 4px 4px;
	}
	/* Brain structures: hidden inside the head until the psychology scene's
	   loop explodes them outward (positions in src/scripts/homepage.ts). */
	.brain {
		position: absolute;
		left: 50%;
		top: 50%;
		opacity: 0;
		box-sizing: border-box;
		border: 2px solid var(--accent);
		background: var(--bg);
	}
	.frontal {
		width: 18px;
		height: 14px;
		margin: -7px 0 0 -9px;
		border-radius: 60% 80% 40% 50%;
	}
	.parietal {
		width: 18px;
		height: 12px;
		margin: -6px 0 0 -9px;
		border-radius: 80% 80% 30% 30%;
	}
	.occipital {
		width: 13px;
		height: 13px;
		margin: -6px 0 0 -6px;
		border-radius: 80% 30% 50% 70%;
	}
	.temporal {
		width: 20px;
		height: 9px;
		margin: -4px 0 0 -10px;
		border-radius: 50% 70% 60% 40%;
	}
	.cerebellum {
		width: 13px;
		height: 10px;
		margin: -5px 0 0 -6px;
		border-radius: 50%;
		/* Folds. */
		background:
			repeating-linear-gradient(to bottom, transparent 0 2px, var(--accent) 2px 3px),
			var(--bg);
	}
	.stem {
		width: 6px;
		height: 14px;
		margin: -7px 0 0 -3px;
		border-radius: 3px 3px 2px 2px;
	}
	.prop {
		opacity: 0;
		border: 2px solid var(--accent);
	}
	.prop-bike {
		inset: 0;
		border: none;
	}
	.bike-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		fill: none;
		stroke: var(--accent);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.bike-frame .saddle {
		stroke-width: 5;
	}
	.prop-bike .wheel {
		position: absolute;
		bottom: 0;
		left: 10px;
		width: 56px;
		height: 56px;
		border: 2px solid var(--accent);
		border-radius: 50%;
	}
	.prop-bike .wheel:last-child {
		left: auto;
		right: 10px;
	}
	/* Spokes, so you can see the wheels turn. */
	.prop-bike .wheel::before,
	.prop-bike .wheel::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 4px;
		bottom: 4px;
		width: 2px;
		margin-left: -1px;
		background: var(--accent);
	}
	.prop-bike .wheel::after {
		transform: rotate(90deg);
	}
	/* Desk with a computer monitor; the hands rest on the desk top. */
	.prop-desk {
		inset: 0;
		border: none;
	}
	.prop-desk span {
		position: absolute;
		background: var(--accent);
	}
	.prop-desk .monitor {
		left: 146px;
		top: 46px;
		width: 50px;
		height: 36px;
		box-sizing: border-box;
		border: 2px solid var(--accent);
		border-radius: 3px;
		/* Three short "code lines" on the screen. */
		background:
			linear-gradient(var(--accent), var(--accent)) 6px 8px / 24px 2px no-repeat,
			linear-gradient(var(--accent), var(--accent)) 10px 15px / 28px 2px no-repeat,
			linear-gradient(var(--accent), var(--accent)) 10px 22px / 16px 2px no-repeat,
			var(--bg);
	}
	.prop-desk .monitor-stand {
		left: 168px;
		top: 82px;
		width: 6px;
		height: 14px;
	}
	.prop-desk .desk-top {
		left: 120px;
		top: 96px;
		width: 84px;
		height: 3px;
	}
	.prop-desk .desk-leg {
		left: 198px;
		top: 96px;
		width: 3px;
		height: 92px;
	}
	/* Stool under the hips, standing on the same floor as the desk. */
	.prop-desk .stool-seat {
		left: 80px;
		top: 150px;
		width: 40px;
		height: 5px;
		border-radius: 2px;
	}
	.prop-desk .stool-leg {
		left: 98px;
		top: 155px;
		width: 4px;
		height: 33px;
	}
	.prop-desk .stool-base {
		left: 86px;
		top: 185px;
		width: 28px;
		height: 3px;
	}
	/* An open book held in both hands, pages tilted like an open spine. */
	.prop-book {
		left: 138px;
		top: 56px;
		width: 52px;
		height: 34px;
		border: none;
	}
	.page {
		position: absolute;
		top: 0;
		width: 26px;
		height: 32px;
		box-sizing: border-box;
		border: 2px solid var(--accent);
		/* Lines of text. */
		background:
			repeating-linear-gradient(to bottom, transparent 0 6px, var(--accent) 6px 7px) 4px 5px / 14px 20px
				no-repeat,
			var(--bg);
	}
	.page-l {
		left: 0;
		border-radius: 3px 0 0 3px;
		transform: skewY(8deg);
		transform-origin: right center;
	}
	.page-r {
		right: 0;
		border-radius: 0 3px 3px 0;
		transform: skewY(-8deg);
		transform-origin: left center;
	}
</style>
