---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOPICS, type Topic } from '../consts';

// The homepage scenes, in scroll order (see "Homepage plan" in docs/plan.md).
// `id` must match a pose in src/scripts/homepage.ts.
// Topic scenes show only their buttons under the sticky "I write about"
// heading; `title` labels the section for screen readers.
// The intro's text is written out in the markup below, since parts of it are
// highlighted.
const scenes: { id: string; title: string; text?: string; topics: Topic[] }[] = [
	{ id: 'stand', title: 'Intro', topics: [] },
	{
		id: 'run',
		title: 'Running',
		text: 'Training logs, races and what I learn about building endurance.',
		topics: ['running'],
	},
	{ id: 'bike', title: 'Biking', text: 'Rides, routes and gear.', topics: ['biking'] },
	{
		id: 'desk',
		title: 'Productivity',
		text: 'Code and AI, quant trading, and personal finance.',
		topics: ['programming-ai', 'quant', 'finance'],
	},
	{
		id: 'read',
		title: 'Psychology',
		text: 'Notes on how minds work, mostly from books.',
		topics: ['psychology'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- The figure: CSS shapes and SVG props, posed and animated by
			     src/scripts/homepage.ts. -->
			<div class="stage" aria-hidden="true">
				<div class="figure-scale">
				<div class="figure">
					<div class="prop prop-bike">
						<!-- Race bike in the figure's own coordinates (200 x 260), with
						     real road-bike proportions (~9 mm per px): 700c-size wheels
						     (radius 36) on the ground at y 230, hubs at 77,194 and 187,194
						     (110 wheelbase), crank 121,202 sitting 8 below the hub line,
						     73° seat tube with a seatpost to the saddle under the hip
						     (100,143), a short head tube, a raked fork, and drop bars whose
						     top is level with the saddle (hands on the drops ~197,170).
						     The crank's numbers are mirrored in src/scripts/homepage.ts. -->
						<svg class="bike-frame" viewBox="0 0 200 260">
							<!-- Chainstay, seat tube, seatpost; seat stay. -->
							<path d="M77 194 L121 202 L108 159 L105 149 M77 194 L108 159" />
							<!-- Top tube, down tube. -->
							<path d="M108 159 L168 148 M121 202 L171 158" />
							<!-- Head tube, then the fork raking forward to the front hub. -->
							<path class="head-tube" d="M168 148 L171 158" />
							<path d="M171 158 L187 194" />
							<!-- Stem and drop handlebar. -->
							<path d="M168 148 L192 148 C201 149 201 162 196 170 L191 171" />
							<path class="saddle" d="M90 148 L118 148" />
							<circle cx="121" cy="202" r="10" />
							<path class="crank" d="M107 202 L135 202" />
						</svg>
						<span class="wheel"></span>
						<span class="wheel"></span>
					</div>
					<div class="prop prop-desk">
						<span class="monitor">
							<span class="code-line"></span>
							<span class="code-line"></span>
							<span class="code-line"></span>
						</span>
						<span class="monitor-stand"></span>
						<span class="desk-top"></span>
						<span class="desk-leg"></span>
						<span class="stool-seat"></span>
						<span class="stool-leg"></span>
						<span class="stool-base"></span>
					</div>
					<div class="prop prop-book"><span class="page page-l"></span><span class="page page-r"></span></div>
					<!-- Superhero cape, behind the body; shown on the intro only. -->
					<div class="cape"></div>
					<div class="part head">
						<span class="gear headband"></span>
						<!-- Bike helmet in the head's coordinates (36 x 36, facing right):
						     a teardrop swept back to a point, with vents and a chin strap. -->
						<svg class="bike-gear helmet" viewBox="-10 -8 56 46">
							<path class="shell" d="M37 15 C38 4 26 -6 12 -5 C2 -4 -6 2 -10 10 L-2 14 C8 10 26 10 37 15 Z" />
							<path class="vents" d="M7 -1 L12 6 M17 -3 L20 5 M27 -1 L28 6" />
							<path class="strap" d="M4 14 L22 34 L30 30" />
						</svg>
						<!-- Brain parts that burst out of the head in the psychology scene. -->
						<!-- The brain in side view (facing right), drawn in the head's
						     coordinates: each part is an outline plus its folds. -->
						<svg class="brain-art" viewBox="-10 -10 56 56">
							<g class="brain frontal">
								<path d="M20 7 C27 5 33 10 34 17 C34.5 20.5 32.5 22 30 22 L24.5 21.2 C22.5 17 21.2 12 20 7 Z" />
								<path class="fold" d="M23.5 9.5 C25.5 11.5 27 13.5 30.5 14.5 M25.5 17 C27.5 18 30 18 32.5 18.8 M27.5 8.5 C29 10 30.5 11 32 11.5" />
							</g>
							<g class="brain parietal">
								<path d="M8.5 9.5 C11.5 6 16.5 5.5 20 7 C21.2 12 22.5 17 24.5 21.2 L16.5 20.2 C14.5 16 12 12.5 8.5 9.5 Z" />
								<path class="fold" d="M12.5 8.5 C14.5 11.5 16 14 19.5 16.5 M16 7 C17.5 9.5 18.5 11 21 13" />
							</g>
							<g class="brain occipital">
								<path d="M3 17.5 C2.5 13 5.5 9.5 8.5 9.5 C12 12.5 14.5 16 16.5 20.2 L8 22.5 C5 22.5 3.2 20.5 3 17.5 Z" />
								<path class="fold" d="M5.5 13 C7.5 15 10 16.5 12.5 18.5 M5 18.5 C7 19 9 19.5 11 20.5" />
							</g>
							<g class="brain temporal">
								<path d="M14 22.5 C18 20.5 25 21 30.5 22.2 C31 25.5 28 28.5 22.5 28.5 C18 28.5 15 26.5 14 22.5 Z" />
								<path class="fold" d="M17 24.5 C20.5 25.5 24.5 25.5 28 24.2" />
							</g>
							<g class="brain cerebellum">
								<path d="M5.5 24.5 C7.5 22 12.5 22 14 25 C14.5 28 11.5 30.5 8.5 29.8 C6 29.2 4.8 26.8 5.5 24.5 Z" />
								<path class="fold" d="M6.5 24.8 L13 24.8 M6 26.6 L13.6 26.6 M6.6 28.4 L12.6 28.4" />
							</g>
							<g class="brain stem">
								<path d="M15.5 27 C16.8 26.6 18.4 26.8 19.5 27.8 L18.6 35 L16.2 35 Z" />
							</g>
						</svg>
					</div>
					<div class="part torso"></div>
					<div class="part arm arm-l"><span class="seg"></span></div>
					<div class="part arm arm-r"><span class="seg"></span></div>
					<div class="part leg leg-l"><span class="seg"><span class="shin"><span class="calf"><span class="gear shoe"></span></span></span></span></div>
					<div class="part leg leg-r"><span class="seg"><span class="shin"><span class="calf"><span class="gear shoe"></span></span></span></span></div>
				</div>
				</div>
			</div>

			<!-- All the homepage text, pinned in one place. The intro and the
			     "I write about" block share the same spot: scrolling fades the
			     intro out and the topics in, then cross-fades between each
			     scene's buttons (src/scripts/homepage.ts). -->
			<div class="text-panel" style="grid-row: 1 / span 5">
				<div class="intro-block">
					<h1>Hi, I'm <span class="highlight">Shreyans</span>.</h1>
					<p>
						This is where I write down what I learn.
						<br />
						<span class="highlight">Scroll</span> to look around.
					</p>
				</div>
				<div class="topics-block">
					<h2 class="write-about">
						I write about<span class="dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span>
					</h2>
					<div class="topic-groups">
						{scenes.slice(1).map((scene) => (
							<div class="topic-group" data-scene={scene.id} aria-label={scene.title}>
								<p class="links">
									{scene.topics.map((topic) => (
										<a class="button" href={`/topics/${topic}/`}>
											{TOPICS[topic]}
										</a>
									))}
								</p>
								<p class="topic-text">{scene.text}</p>
							</div>
						))}
					</div>
				</div>
			</div>

			<!-- One full-screen block per scene: the scroll distance that drives
			     the figure and the text fades. -->
			{scenes.map((scene, i) => (
				<div class="scene" data-scene={scene.id} style={`grid-row: ${i + 1}`}></div>
			))}
		</main>
		<!-- No footer here: the page ends with the last scene, so the pinned
		     figure stays in place right to the end. -->
		<script>
			import '../scripts/homepage.ts';
		</script>
	</body>
</html>

<style>
	/* Full-width page: undo the narrow column that global.css gives <main>. */
	main.home {
		/* Where the pinned text panel sits: below the figure on phones,
		   beside it on desktop. */
		--label-top: 71svh;
		display: grid;
		grid-template-columns: 1fr;
		width: auto;
		max-width: none;
		padding: 0;
	}

	/* The stage spans every scene's row and sticks to the top of the screen,
	   so the figure stays put while you scroll. */
	.stage {
		grid-column: 1;
		grid-row: 1 / span 5;
		position: sticky;
		top: 0;
		align-self: start;
		height: 100svh;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 7svh;
		box-sizing: border-box;
		pointer-events: none;
	}

	.scene {
		grid-column: 1;
		min-height: 100svh;
	}
	.text-panel {
		grid-column: 1;
		position: sticky;
		top: var(--label-top);
		align-self: start;
		z-index: 2;
		display: grid;
		padding: 0 1em;
	}
	/* The intro and the topics share one grid cell and cross-fade. */
	.intro-block,
	.topics-block {
		grid-area: 1 / 1;
		align-self: start;
		max-width: 32em;
	}
	.intro-block h1 {
		font-size: 2em;
	}
	.highlight {
		color: var(--accent);
	}
	.write-about {
		margin: 0 0 0.8em;
		color: var(--text-heading);
		font-size: 1.6em;
	}
	/* All groups share one grid cell, so they sit on top of each other and
	   only the visible one shows. */
	.topic-groups {
		display: grid;
	}
	.topic-group {
		grid-area: 1 / 1;
		align-self: start;
	}
	.topic-group .links {
		margin: 0;
	}
	.topic-text {
		margin: 0.8em 0 0;
		max-width: 32em;
	}
	/* "I write about..." with the dots appearing one, two, three, then
	   starting over. */
	.dots span {
		animation: dot 1.6s steps(1, end) infinite;
	}
	.dots span:nth-child(2) {
		animation-name: dot2;
	}
	.dots span:nth-child(3) {
		animation-name: dot3;
	}
	@keyframes dot {
		0% { opacity: 0; }
		25% { opacity: 1; }
	}
	@keyframes dot2 {
		0% { opacity: 0; }
		50% { opacity: 1; }
	}
	@keyframes dot3 {
		0% { opacity: 0; }
		75% { opacity: 1; }
	}
	@media (prefers-reduced-motion: reduce) {
		.dots span {
			animation: none;
		}
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.button {
		padding: 0.4em 0.9em;
		border: 1px solid var(--accent);
		border-radius: 4px;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent);
		color: var(--bg);
		text-shadow: none;
	}

	/* Scales the whole figure. A wrapper is used because GSAP owns the
	   transform on .figure itself.
	   Defined before the media queries below so their sizes win. */
	.figure-scale {
		--figure-scale: 1.6;
		transform: scale(var(--figure-scale));
		transform-origin: top center;
	}

	/* Tablet and desktop: figure on the left, text on the right. */
	@media (min-width: 700px) {
		main.home {
			grid-template-columns: 1fr 1fr;
			--label-top: 40svh;
		}
		.text-panel {
			grid-column: 2;
			padding: 0 8vw 0 2em;
		}
		.stage {
			grid-column: 1;
			align-items: center;
			padding-top: 0;
		}
		.scene {
			grid-column: 2;
		}
		.figure-scale {
			--figure-scale: 2.3;
			transform-origin: center;
		}
	}

	/* Short screens: keep the figure inside the screen and clear of the text. */
	@media (max-width: 699px) and (max-height: 700px) {
		main.home {
			--label-top: 64svh;
		}
		.figure-scale {
			--figure-scale: 1.1;
		}
	}
	/* Side-by-side layouts: the figure gets half the width, so narrower
	   screens (tablets in portrait) need a smaller figure to fit the bike
	   and desk scenes. */
	@media (min-width: 700px) and (max-width: 899px) {
		.figure-scale {
			--figure-scale: 1.7;
		}
	}
	@media (min-width: 900px) and (max-width: 1199px) {
		.figure-scale {
			--figure-scale: 2.1;
		}
	}
	/* Big desktop screens: go bigger still. */
	@media (min-width: 1200px) and (min-height: 950px) {
		.figure-scale {
			--figure-scale: 2.7;
		}
	}
	/* Height caps come last so they win: short windows, then very short ones
	   (phones held sideways). */
	@media (min-width: 700px) and (max-height: 700px) {
		.figure-scale {
			--figure-scale: 1.6;
		}
	}
	@media (min-width: 700px) and (max-height: 500px) {
		.figure-scale {
			--figure-scale: 1;
		}
	}

	/* --- The figure: simple blocks GSAP can rotate per pose. --- */
	.figure {
		position: relative;
		width: 200px;
		height: 260px;
		--limb: var(--text-heading);
	}
	.part,
	.prop {
		position: absolute;
	}
	.part {
		background: var(--limb);
		border-radius: 999px;
	}
	/* Drawing order: the far arm and leg (-l) go behind the body, the near
	   ones (-r) in front, so a limb swinging behind the torso is hidden. */
	.arm-l,
	.leg-l {
		z-index: 0;
	}
	.torso,
	.head {
		z-index: 1;
	}
	.arm-r,
	.leg-r {
		z-index: 2;
	}
	.head {
		width: 36px;
		height: 36px;
		left: 82px;
		top: 20px;
	}
	.torso {
		width: 26px;
		height: 80px;
		left: 87px;
		top: 62px;
		transform-origin: 50% 100%;
	}
	/* Limbs: the outer element takes the scroll pose, the inner .seg is what
	   you see, and the motion loops (wave, stride, pedalling) rotate it on
	   top of the pose without fighting the scroll timeline. */
	.arm,
	.leg {
		background: none;
	}
	.seg {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		transform-origin: inherit;
		background: var(--limb-colour);
	}
	/* Far-side limbs are darker; homepage.ts tweens this variable to match
	   the near side when the figure faces the viewer. */
	.arm,
	.leg {
		--limb-colour: var(--text-muted);
	}
	.arm-r,
	.leg-r {
		--limb-colour: var(--limb);
	}
	.arm {
		width: 12px;
		height: 64px;
		left: 94px;
		top: 68px;
		transform-origin: 50% 6px;
	}
	/* Leg = thigh (the .seg) + shin. Hip pivot 7px from the top, knee 40px
	   below it, foot 40px below the knee. */
	.leg {
		width: 14px;
		height: 54px;
		left: 93px;
		top: 136px;
		transform-origin: 50% 7px;
	}
	/* Like the limbs: .shin takes the pose's knee bend, the visible .calf
	   takes the motion loops' extra bend on top. */
	.shin,
	.calf {
		position: absolute;
		border-radius: 7px;
		transform-origin: 50% 7px;
	}
	.shin {
		left: 0;
		top: 40px;
		width: 100%;
		height: 54px;
	}
	.calf {
		inset: 0;
		background: var(--limb-colour);
	}
	/* Running gear sits inside the head and legs so it moves with them. */
	.gear {
		position: absolute;
		opacity: 0;
		background: var(--accent);
	}
	.headband {
		left: -2px;
		top: 9px;
		width: 40px;
		height: 7px;
		border-radius: 2px;
	}
	/* The knot's tail, at the back of the head (the figure faces right). */
	.headband::after {
		content: '';
		position: absolute;
		left: -9px;
		top: 2px;
		width: 12px;
		height: 4px;
		background: inherit;
		transform: rotate(25deg);
		transform-origin: right center;
	}
	/* Cape: hangs from the shoulders and flares out toward the bottom, with
	   a slightly uneven hem. Billows with the wave (homepage.ts). */
	.cape {
		position: absolute;
		left: 62px;
		top: 64px;
		width: 76px;
		height: 124px;
		opacity: 0;
		background: var(--accent);
		clip-path: polygon(30% 0, 70% 0, 100% 96%, 82% 100%, 64% 95%, 46% 100%, 28% 95%, 12% 100%, 0 96%);
		transform-origin: 50% 0;
	}
	/* Bike helmet (SVG, drawn in the head's coordinates). */
	.bike-gear {
		position: absolute;
		opacity: 0;
	}
	.helmet {
		left: -10px;
		top: -8px;
		width: 56px;
		height: 46px;
		overflow: visible;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.helmet .shell {
		fill: var(--accent);
	}
	.helmet .vents {
		stroke: var(--bg);
		stroke-width: 2;
	}
	.helmet .strap {
		stroke: var(--accent);
		stroke-width: 1.5;
	}
	.shoe {
		left: -1px;
		bottom: -3px;
		width: 26px;
		height: 10px;
		border-radius: 3px 8px 4px 4px;
	}
	/* Brain: an SVG drawn over the head (so it reads like an X-ray). Each
	   part starts hidden; the psychology scene's loop shows it assembled,
	   explodes it outward and brings it back (src/scripts/homepage.ts). */
	/* Drawn at 85% and shifted up so the lobes fill the top of the skull
	   (brain top just under the crown) and only the brainstem reaches down
	   toward the neck, instead of sitting over the face. */
	.brain-art {
		position: absolute;
		left: -6px;
		top: -10px;
		width: 47.6px;
		height: 47.6px;
		overflow: visible;
		pointer-events: none;
	}
	.brain {
		opacity: 0;
		fill: var(--bg);
		stroke: var(--accent);
		stroke-width: 1.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.brain .fold {
		fill: none;
		stroke-width: 0.8;
	}
	.prop {
		opacity: 0;
		border: 2px solid var(--accent);
	}
	.prop-bike {
		inset: 0;
		border: none;
	}
	.bike-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		fill: none;
		stroke: var(--accent);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.bike-frame .saddle {
		stroke-width: 5;
	}
	.bike-frame .head-tube {
		stroke-width: 5;
	}
	.prop-bike .wheel {
		position: absolute;
		/* Hubs at 77,194 and 187,194; radius 36. */
		top: 158px;
		left: 41px;
		width: 72px;
		height: 72px;
		border: 2px solid var(--accent);
		border-radius: 50%;
	}
	.prop-bike .wheel:last-child {
		left: 151px;
	}
	/* Spokes, so you can see the wheels turn. */
	.prop-bike .wheel::before,
	.prop-bike .wheel::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 4px;
		bottom: 4px;
		width: 2px;
		margin-left: -1px;
		background: var(--accent);
	}
	.prop-bike .wheel::after {
		transform: rotate(90deg);
	}
	/* Desk with a computer monitor; the hands rest on the desk top. */
	.prop-desk {
		inset: 0;
		border: none;
	}
	.prop-desk span {
		position: absolute;
		background: var(--accent);
	}
	.prop-desk .monitor {
		left: 146px;
		top: 46px;
		width: 50px;
		height: 36px;
		box-sizing: border-box;
		border: 2px solid var(--accent);
		border-radius: 3px;
		background: var(--bg);
	}
	/* Code on the screen: each line types itself out a few characters at a
	   time, one after the other, holds, then the screen clears and it
	   starts again. */
	.prop-desk .code-line {
		height: 2px;
		/* Written out longhand: the build's CSS minifier turns a shorthand
		   with no animation name into "animation: none". */
		animation-duration: 4s;
		animation-iteration-count: infinite;
		animation-timing-function: steps(6, end);
	}
	.prop-desk .code-line:nth-child(1) {
		left: 4px;
		top: 6px;
		width: 24px;
		animation-name: type-line-1;
	}
	.prop-desk .code-line:nth-child(2) {
		left: 8px;
		top: 13px;
		width: 28px;
		animation-name: type-line-2;
	}
	.prop-desk .code-line:nth-child(3) {
		left: 8px;
		top: 20px;
		width: 16px;
		animation-name: type-line-3;
	}
	@keyframes type-line-1 {
		0% { width: 0; }
		18%, 90% { width: 24px; }
		90.1%, 100% { width: 0; }
	}
	@keyframes type-line-2 {
		0%, 20% { width: 0; }
		42%, 90% { width: 28px; }
		90.1%, 100% { width: 0; }
	}
	@keyframes type-line-3 {
