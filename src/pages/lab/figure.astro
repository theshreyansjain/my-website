---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

// The homepage scenes, in scroll order; slider positions 0 to 4.
const scenes = ['Stand', 'Run', 'Bike', 'Desk', 'Read'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Figure lab | ${SITE_TITLE}`}
			description="Work-in-progress 3D figure for the homepage."
			noindex
		/>
	</head>
	<body>
		<Header />
		<main class="lab">
			<h1>Figure lab</h1>
			<p class="muted">
				The 3D figure for the homepage, in progress. Drag the slider to scrub through the scenes the
				way scrolling will, or jump to one.
			</p>
			<div class="lab-stage"></div>
			<div class="controls">
				<input id="scene" type="range" min="0" max="4" step="0.001" value="0" aria-label="Scene" />
				<div class="scene-buttons">
					{scenes.map((name, i) => (
						<button type="button" data-goto={i}>
							{name}
						</button>
					))}
				</div>
				<label class="muted">
					<input id="motion" type="checkbox" checked /> Motion
				</label>
			</div>
		</main>
		<Footer />
		<script>
			import '../../scripts/lab-figure.ts';
		</script>
	</body>
</html>

<style>
	main.lab {
		width: 960px;
	}
	.muted {
		color: var(--text-muted);
	}
	.lab-stage {
		height: 60svh;
		min-height: 320px;
		border: 1px solid var(--border);
		border-radius: 8px;
	}
	.lab-stage :global(canvas) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.controls {
		display: flex;
		flex-direction: column;
		gap: 0.8em;
		margin-top: 1em;
	}
	#scene {
		width: 100%;
		accent-color: var(--accent);
	}
	.scene-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	button {
		padding: 0.3em 0.8em;
		border: 1px solid var(--accent);
		border-radius: 4px;
		background: none;
		color: var(--accent);
		font: inherit;
		font-size: 0.85em;
		cursor: pointer;
	}
	button:hover {
		background: var(--accent);
		color: var(--bg);
	}
	label input {
		accent-color: var(--accent);
	}
</style>
